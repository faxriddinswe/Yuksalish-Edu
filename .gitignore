# Generated files and local evidence can contain paths, identities and snapshots.
*.tsbuildinfo
/frontend/next-env.d.ts
/docs/*.json
/docs/*.xml
/docs/screenshots/
/docs/load-results/
/docs/implementation-status.md

# Keep certificate source images, student manifests and consent records local.
/certificates/**
!/certificates/**/
!/certificates/README.md
!/certificates/*.example.json
!/certificates/**/.gitkeep
