# .env.production ga nusxalang, haqiqiy maxfiy qiymatlarni xavfsiz generatsiya qiling.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=yuksalish
POSTGRES_USER=yuksalish
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=yuksalish.sherabod.uz,backend,localhost
CSRF_TRUSTED_ORIGINS=https://yuksalish.sherabod.uz
REDIS_URL=redis://redis:6379/0
API_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_SITE_URL=https://yuksalish.sherabod.uz
# Faqat Compose ichki Nginx proksisi manzillari; host tarmog‘iga moslang.
TRUSTED_PROXY_NETWORKS=172.16.0.0/12
