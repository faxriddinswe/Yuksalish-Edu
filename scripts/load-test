#!/usr/bin/env python3
import subprocess
import argparse
from pathlib import Path
root=Path(__file__).resolve().parents[1]
parser=argparse.ArgumentParser();parser.add_argument('--profile',choices=['development','gunicorn'],default='development');options=parser.parse_args()
folder=root/'docs/load-results'/options.profile;folder.mkdir(parents=True,exist_ok=True)
host='http://127.0.0.1:8002'
for users,seconds in [(10,20),(50,30),(100,20)]:
    subprocess.run([str(root/'.venv/bin/locust'),'-f',str(root/'tests/load/locustfile.py'),'--headless','--host',host,'--users',str(users),'--spawn-rate','10','--run-time',f'{seconds}s','--stop-timeout','5','--csv',str(folder/f'users-{users}'),'--only-summary'],check=True)
