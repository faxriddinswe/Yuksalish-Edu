#!/usr/bin/env python3
import os
from pathlib import Path
root=Path(__file__).resolve().parents[1]
redis_root=root/'.local/redis'
data=root/'.local/redis-data'
data.mkdir(exist_ok=True)
os.environ['LD_LIBRARY_PATH']=str(redis_root/'usr/lib/x86_64-linux-gnu')
os.execv(str(redis_root/'usr/bin/redis-server'),['redis-server','--bind','127.0.0.1','--port','56379','--dir',str(data),'--appendonly','yes','--protected-mode','yes'])
