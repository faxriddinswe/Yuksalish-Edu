#!/usr/bin/env python3
"""Lokal muhitni yuklab Django management buyrug‘ini bajaradi."""
import os
from pathlib import Path
root=Path(__file__).resolve().parents[1]
for line in (root/'.env.local').read_text().splitlines() if (root/'.env.local').exists() else []:
    if line and not line.startswith('#') and '=' in line:
        key,value=line.split('=',1)
        os.environ.setdefault(key,value)
os.chdir(root/'backend')
import sys
os.execv(str(root/'.venv/bin/python'),[str(root/'.venv/bin/python'),'manage.py',*sys.argv[1:]])
