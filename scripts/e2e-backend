#!/usr/bin/env python3
import os
import sys
import subprocess
from pathlib import Path
root=Path(__file__).resolve().parents[1]
for line in (root/'.env.local').read_text().splitlines() if (root/'.env.local').exists() else []:
    if line and not line.startswith('#') and '=' in line:
        key,value=line.split('=',1)
        os.environ.setdefault(key,value)
os.environ['POSTGRES_DB']='e2e_'+os.environ.get('POSTGRES_DB','yuksalish')
# Isolate cache keys from the main app and previous browser runs.
os.environ['DJANGO_CACHE_KEY_PREFIX']=f'yuksalish:e2e:{os.getpid()}'
os.environ['CSRF_TRUSTED_ORIGINS']='http://localhost:3001,http://127.0.0.1:3001'
os.environ['DJANGO_SETTINGS_MODULE']='config.settings.local'
os.chdir(root/'backend')
if sys.argv[1:2] == ['runserver']:
    subprocess.run(
        [str(root/'.venv/bin/python'), 'manage.py', 'reset_e2e_limits'],
        check=True,
    )
os.execv(str(root/'.venv/bin/python'),[str(root/'.venv/bin/python'),'manage.py',*sys.argv[1:]])
