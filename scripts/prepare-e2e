#!/usr/bin/env python3
import os
import subprocess
from pathlib import Path
import psycopg
from psycopg import sql
root=Path(__file__).resolve().parents[1]
for line in (root/'.env.local').read_text().splitlines() if (root/'.env.local').exists() else []:
    if line and not line.startswith('#') and '=' in line:
        key,value=line.split('=',1)
        os.environ.setdefault(key,value)
source=os.environ.get('POSTGRES_DB','yuksalish')
target='e2e_'+source
if target==source or not target.startswith('e2e_'):
    raise SystemExit('Test bazasi nomi xavfsiz emas.')
with psycopg.connect(host=os.getenv('POSTGRES_HOST','127.0.0.1'),port=os.getenv('POSTGRES_PORT','55432'),user=os.getenv('POSTGRES_USER'),password=os.getenv('POSTGRES_PASSWORD',''),dbname='postgres',autocommit=True) as conn:
    if not conn.execute('SELECT 1 FROM pg_database WHERE datname=%s',[target]).fetchone():
        conn.execute(sql.SQL('CREATE DATABASE {}').format(sql.Identifier(target)))
env={**os.environ,'POSTGRES_DB':target,'DJANGO_SETTINGS_MODULE':'config.settings.local'}
for args in [['migrate','--noinput'],['seed_demo','--students','100']]:
    subprocess.run([str(root/'.venv/bin/python'),str(root/'backend/manage.py'),*args],cwd=root/'backend',env=env,check=True)
print('Alohida E2E bazasi tayyor. Ishchi bazaga tegilmadi.')
